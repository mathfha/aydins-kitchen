---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import OrderGuide from '../components/OrderGuide.astro';
import Footer from '../components/Footer.astro';
import { STORE_INFO } from '../data/cakes';

const title = `${STORE_INFO.name} - Kue Ulang Tahun Brownies di Gambut dan Banjarmasin`;
const description = `Kue ulang tahun brownies panggang buatan Kak Winda di Gambut. Lihat foto desain kue, kisaran harga, dan pesan langsung lewat WhatsApp.`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Fraunces (700) & Plus Jakarta Sans (400, 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700&family=Plus+Jakarta+Sans:wght@400;700&display=swap" 
      rel="stylesheet" 
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=1200&auto=format&fit=crop" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Bakery",
      "name": STORE_INFO.name,
      "founder": {
        "@type": "Person",
        "name": STORE_INFO.owner
      },
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gambut",
        "addressRegion": "Kalimantan Selatan",
        "addressCountry": "ID"
      },
      "areaServed": STORE_INFO.serviceAreas,
      "priceRange": "Rp 55.000 - Rp 260.000",
      "telephone": STORE_INFO.phoneDisplay
    })} />
  </head>
  <body class="bg-[#FDF4F7] text-[#4E2A36] antialiased min-h-screen flex flex-col pb-20 sm:pb-0 selection:bg-[#FCEAEF] selection:text-[#EE7A9A]">
    <main class="flex-grow">
      <Hero />
      <Gallery />
      <OrderGuide />
    </main>

    <Footer />

    <!-- Tombol WhatsApp Mengambang Khusus Mobile -->
    <aside class="sm:hidden fixed bottom-4 right-4 z-40">
      <a 
        href={`https://wa.me/${STORE_INFO.whatsappNumber}?text=Halo%20Kak%20Winda%20(aydin's%20Kitchen),%20saya%20mau%20tanya%20slot%20kue.`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat WhatsApp Kak Winda"
        class="btn-whatsapp text-xs py-2.5 px-3.5 shadow-lg"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2a9.96 9.96 0 0 0-8.52 15.17L2 22l4.98-1.42A9.96 9.96 0 1 0 12 2zm5.472 12.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.678.15-.201.3-.778.978-.954 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.3-.019-.463.132-.613.135-.135.301-.351.451-.527.151-.176.201-.3.301-.501.101-.2.05-.376-.025-.526-.075-.15-.678-1.634-.928-2.236-.244-.587-.492-.507-.678-.517-.175-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.3-1.053 1.028-1.053 2.508 0 1.48 1.078 2.909 1.229 3.109.15.201 2.122 3.24 5.141 4.544.718.31 1.279.495 1.716.634.721.23 1.377.197 1.896.12.578-.087 1.78-.727 2.031-1.429.251-.702.251-1.303.176-1.429-.075-.126-.276-.201-.577-.351z"/>
        </svg>
        <span>Chat WA</span>
      </a>
    </aside>
  </body>
</html>
