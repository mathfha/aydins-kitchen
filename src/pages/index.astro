---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import OrderGuide from '../components/OrderGuide.astro';
import Footer from '../components/Footer.astro';
import { STORE_INFO } from '../data/cakes';

const title = `${STORE_INFO.name} - Kue Ulang Tahun Brownies di Gambut dan Banjarmasin`;
const description = `Kue ulang tahun brownies panggang buatan Kak Winda di Gambut. Lihat foto desain kue, kisaran harga, dan pesan langsung lewat WhatsApp.`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Fraunces (700) & Plus Jakarta Sans (400, 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700&family=Plus+Jakarta+Sans:wght@400;700&display=swap" 
      rel="stylesheet" 
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=1200&auto=format&fit=crop" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Bakery",
      "name": STORE_INFO.name,
      "founder": {
        "@type": "Person",
        "name": STORE_INFO.owner
      },
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gambut",
        "addressRegion": "Kalimantan Selatan",
        "addressCountry": "ID"
      },
      "areaServed": STORE_INFO.serviceAreas,
      "priceRange": "Rp 55.000 - Rp 260.000",
      "telephone": STORE_INFO.phoneDisplay
    })} />
  </head>
  <body class="bg-[#FDF4F7] text-[#4E2A36] antialiased min-h-screen flex flex-col pb-20 sm:pb-0 selection:bg-[#FCEAEF] selection:text-[#EE7A9A]">
    <main class="flex-grow">
      <Hero />
      <Gallery />
      <OrderGuide />
    </main>

    <Footer />

    <!-- Tombol WhatsApp Mengambang Khusus Mobile -->
    <aside class="sm:hidden fixed bottom-4 right-4 z-40">
      <a 
        href={`https://wa.me/${STORE_INFO.whatsappNumber}?text=Halo%20Kak%20Winda%20(aydin's%20Kitchen),%20saya%20mau%20tanya%20slot%20kue.`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat WhatsApp Kak Winda"
        class="btn-whatsapp text-xs py-2.5 px-3.5 shadow-lg"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.697c1.002.546 1.761.822 2.806.823h.005c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.77-5.773-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
        </svg>
        <span>Chat WA</span>
      </a>
    </aside>
  </body>
</html>
