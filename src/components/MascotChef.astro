---
// Maskot Kak Winda Berkerudung Manis (Pashmina/Bergo Oval) dengan Kacamata Bulat
// Sedang Memanggang Brownies di Oven Vintage & Mengenakan Pin Logo aydin's Kitchen
---

<div class="relative flex flex-col items-center justify-center select-none py-2">
  <!-- Balon Dialog Mengambang -->
  <div class="mascot-bubble mb-2 sm:mb-3 bg-white border-2 border-[#EE7A9A] px-3.5 py-1.5 rounded-2xl shadow-xs relative">
    <span class="text-[11px] font-extrabold text-[#EE7A9A] tracking-wider uppercase block leading-tight">
      Dapur Kak Winda ✨
    </span>
    <p class="text-xs font-bold text-[#4E2A36] leading-tight">
      Lagi manggang brownies fresh! 🧁
    </p>
    <!-- Panah Balon Dialog -->
    <div class="absolute -bottom-2 right-12 w-0 h-0 border-x-6 border-x-transparent border-t-8 border-t-[#EE7A9A]"></div>
    <div class="absolute -bottom-1.5 right-12 w-0 h-0 border-x-5 border-x-transparent border-t-7 border-t-white"></div>
  </div>

  <!-- SVG Karakter Koki Berkerudung Oval Manis & Oven Vintage -->
  <svg 
    viewBox="0 0 460 380" 
    class="w-full h-auto max-w-[340px] sm:max-w-[420px] lg:max-w-[460px] drop-shadow-sm pointer-events-none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Ilustrasi Kak Winda berkerudung manis dengan kacamata bulat dan celemek berlogo aydin's Kitchen sedang memanggang kue brownies di oven vintage pink"
  >
    <defs>
      <!-- Bayangan Tanah Halus -->
      <ellipse id="scene-shadow" cx="225" cy="358" rx="185" ry="14" fill="#4E2A36" opacity="0.14" />
      
      <!-- Clip path lingkaran untuk logo di celemek -->
      <clipPath id="chef-logo-clip">
        <circle cx="0" cy="0" r="19" />
      </clipPath>
    </defs>

    <use href="#scene-shadow" />

    <!-- ======================================================================
         1. OVEN KUE VINTAGE RETRO (Nuansa Pink & Krem Pastel)
         ====================================================================== -->
    <g id="oven-rig" class="oven-group">
      
      <!-- Kaki Oven Membulat Retro -->
      <rect x="52" y="338" width="16" height="16" rx="6" fill="#4E2A36" />
      <rect x="182" y="338" width="16" height="16" rx="6" fill="#4E2A36" />

      <!-- Bodi Luar Oven (Soft Pastel Pink #FCE8EE) -->
      <rect x="42" y="135" width="166" height="210" rx="18" fill="#FCE8EE" stroke="#4E2A36" stroke-width="5" />

      <!-- Panel Atas Pengatur Suhu (Putih Bersih) -->
      <rect x="54" y="147" width="142" height="32" rx="7" fill="#FFFFFF" stroke="#4E2A36" stroke-width="3.5" />
      
      <!-- Kenop Putar Suhu 1 (Rose Pink #EE7A9A) -->
      <circle cx="78" cy="163" r="7.5" fill="#EE7A9A" stroke="#4E2A36" stroke-width="2.5" />
      <line x1="78" y1="158" x2="78" y2="163" stroke="#4E2A36" stroke-width="2.5" stroke-linecap="round" />

      <!-- Dial Termometer Suhu Oven di Tengah -->
      <circle cx="125" cy="163" r="10" fill="#FFFFFF" stroke="#4E2A36" stroke-width="2.5" />
      <line x1="125" y1="163" x2="131" y2="157" stroke="#EE7A9A" stroke-width="2" stroke-linecap="round" />
      <circle cx="125" cy="163" r="2.5" fill="#4E2A36" />

      <!-- Kenop Putar Timer 2 (Rose Pink #EE7A9A) -->
      <circle cx="172" cy="163" r="7.5" fill="#EE7A9A" stroke="#4E2A36" stroke-width="2.5" />
      <line x1="172" y1="163" x2="177" y2="163" stroke="#4E2A36" stroke-width="2.5" stroke-linecap="round" />

      <!-- Ruang Bakar Dalam Oven (Jendela Kaca Gelap Plum #381520) -->
      <rect x="54" y="190" width="142" height="135" rx="10" fill="#381520" stroke="#4E2A36" stroke-width="4.5" />

      <!-- Pendar Cahaya Panas Hangat di Dalam Oven -->
      <rect class="oven-glow-ambient" x="58" y="194" width="134" height="127" rx="8" fill="#EE7A9A" opacity="0.22" />

      <!-- Kawat Pemanas Oven Membara -->
      <line class="oven-coil" x1="68" y1="206" x2="182" y2="206" stroke="#EE7A9A" stroke-width="3.5" stroke-linecap="round" />
      <line class="oven-coil" x1="68" y1="310" x2="182" y2="310" stroke="#EE7A9A" stroke-width="3.5" stroke-linecap="round" />

      <!-- Rak Kawat Oven (Besi Silver) -->
      <line x1="60" y1="268" x2="190" y2="268" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.6" />

      <!-- LOYANG BROWNIES YANG SEDANG DIPANGGANG -->
      <g id="baking-brownies" transform="translate(70, 246)">
        <rect x="0" y="14" width="110" height="14" rx="3" fill="#FFFFFF" stroke="#4E2A36" stroke-width="2.5" />
        <path d="M5 14 Q55 -4 105 14 Z" fill="#4E2A36" stroke="#4E2A36" stroke-width="2.5" />
        <path d="M18 11 Q55 3 92 11" stroke="#FCEAEF" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.8" />
        <circle cx="45" cy="8" r="1.5" fill="#EE7A9A" />
        <circle cx="70" cy="7" r="1.5" fill="#EE7A9A" />
      </g>

      <!-- Frame Pintu Kaca Oven & Gagang Luar -->
      <rect x="50" y="186" width="150" height="143" rx="12" fill="none" stroke="#4E2A36" stroke-width="5" />
      <rect x="75" y="190" width="100" height="8" rx="4" fill="#FFFFFF" stroke="#4E2A36" stroke-width="3" />
      <line x1="72" y1="295" x2="115" y2="215" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" opacity="0.25" />

      <!-- UAP HARUM COKLAT NAIK DARI OVEN (Animasi CSS) -->
      <g class="steam-container">
        <path class="steam-line-1" d="M100 130 Q90 105 105 85 T95 55" stroke="#EE7A9A" stroke-width="2.5" stroke-linecap="round" fill="none" />
        <path class="steam-line-2" d="M130 130 Q145 100 125 75 T140 45" stroke="#EE7A9A" stroke-width="3" stroke-linecap="round" fill="none" />
        <path class="steam-line-3" d="M160 130 Q150 105 165 85 T155 60" stroke="#EE7A9A" stroke-width="2" stroke-linecap="round" fill="none" />
      </g>

      <!-- Bintang Kilau Harum Retro di Sekitar Oven -->
      <path class="sparkle-star-1" d="M38 120 L40 126 L46 128 L40 130 L38 136 L36 130 L30 128 L36 126 Z" fill="#EE7A9A" />
      <path class="sparkle-star-2" d="M208 115 L210 121 L216 123 L210 125 L208 131 L206 125 L200 123 L206 121 Z" fill="#EE7A9A" />
    </g>


    <!-- ======================================================================
         2. KAK WINDA: BERKERUDUNG OVAL MANIS, KACAMATA BULAT & LOGO TOKO
         ====================================================================== -->
    <g id="chef-rig" class="chef-character">

      <!-- KAKI RUBBER HOSE KOKI -->
      <g class="chef-legs">
        <path d="M305 270 Q325 310 340 345" stroke="#4E2A36" stroke-width="12" stroke-linecap="round" fill="none" />
        <ellipse cx="350" cy="348" rx="18" ry="10" fill="#4E2A36" />

        <path d="M265 270 Q250 310 248 345" stroke="#4E2A36" stroke-width="12" stroke-linecap="round" fill="none" />
        <ellipse cx="238" cy="348" rx="18" ry="10" fill="#4E2A36" />
      </g>

      <!-- BADAN KOKI & CELEMEK DENGAN LOGO AYDIN'S KITCHEN -->
      <g class="chef-torso">
        <!-- Gaun Pastel Pink (#FCE8EE) -->
        <path d="M235 180 C240 145 325 155 320 195 L330 285 C330 295 230 295 230 285 Z" fill="#FCE8EE" stroke="#4E2A36" stroke-width="5" stroke-linejoin="round" />

        <!-- Celemek Pink Rose (#EE7A9A) -->
        <path d="M245 178 L305 182 L315 285 L242 285 Z" fill="#EE7A9A" stroke="#4E2A36" stroke-width="4.5" stroke-linejoin="round" />

        <!-- EMBLEM LOGO AYDIN'S KITCHEN RESMI DI DADA CELEMEK -->
        <g id="chef-store-logo" transform="translate(280, 234)">
          <!-- Patch Lingkaran Renda Putih & Pink -->
          <circle cx="0" cy="0" r="23" fill="#FFFFFF" stroke="#4E2A36" stroke-width="3" />
          <circle cx="0" cy="0" r="21" fill="none" stroke="#EE7A9A" stroke-width="1.8" stroke-dasharray="3 2" />
          
          <!-- Logo Gambar Asli aydin's Kitchen -->
          <image 
            href="/logo.webp" 
            x="-20" 
            y="-20" 
            width="40" 
            height="40" 
            preserveAspectRatio="xMidYMid meet"
            clip-path="url(#chef-logo-clip)"
          />
        </g>
      </g>

      <!-- LENGAN KIRI DENGAN SARUNG OVEN (Menjaga Pintu Oven) -->
      <g class="chef-arm-left">
        <path d="M245 195 Q205 220 200 245" stroke="#4E2A36" stroke-width="12" stroke-linecap="round" fill="none" />
        <g transform="translate(195, 245) rotate(-15)">
          <rect x="-10" y="-8" width="22" height="26" rx="8" fill="#EE7A9A" stroke="#4E2A36" stroke-width="3.5" />
          <circle cx="-8" cy="2" r="5" fill="#EE7A9A" stroke="#4E2A36" stroke-width="2.5" />
          <rect x="-11" y="-12" width="24" height="6" rx="2" fill="#FFFFFF" stroke="#4E2A36" stroke-width="2" />
        </g>
      </g>

      <!-- LENGAN KANAN DENGAN SARUNG OVEN (Melambai Ceria ke Pengunjung) -->
      <g class="chef-arm-right">
        <path d="M315 190 Q355 170 360 125" stroke="#4E2A36" stroke-width="12" stroke-linecap="round" fill="none" />
        <g transform="translate(360, 120)">
          <rect x="-11" y="-10" width="24" height="28" rx="8" fill="#EE7A9A" stroke="#4E2A36" stroke-width="3.5" />
          <circle cx="-10" cy="2" r="5.5" fill="#EE7A9A" stroke="#4E2A36" stroke-width="2.5" />
          <rect x="-12" y="14" width="26" height="7" rx="2" fill="#FFFFFF" stroke="#4E2A36" stroke-width="2" />
          <circle cx="2" cy="4" r="3" fill="#FFFFFF" />
        </g>
      </g>

      <!-- ====================================================================
           KEPALA & KERUDUNG (HIJAB OVAL MANIS SESUAI REFERENSI)
           ==================================================================== -->
      <g class="chef-head">

        <!-- 1. KUBAH KERUDUNG UTAMA (Melengkung Lembut Membungkus Kepala) -->
        <g class="hijab-back">
          <!-- Bentuk Luar Kerudung Menggelembung Lembut (Soft Pastel Pink #FCE8EE) -->
          <path 
            d="M228 115 C215 55 335 45 338 115 C345 160 338 195 315 210 C290 225 245 220 230 195 C218 175 220 145 228 115 Z" 
            fill="#FCE8EE" 
            stroke="#4E2A36" 
            stroke-width="5" 
            stroke-linejoin="round" 
          />
          <!-- Lipatan Lembut Kerudung di Bawah Dagu & Pundak -->
          <path d="M242 185 Q280 215 320 185" stroke="#4E2A36" stroke-width="4" stroke-linecap="round" fill="none" />
          <path d="M255 198 Q280 220 305 198" stroke="#EE7A9A" stroke-width="2.5" stroke-linecap="round" fill="none" />
        </g>

        <!-- 2. BINGKAI WAJAH OVAL DI DALAM KERUDUNG -->
        <g class="hijab-face-opening">
          <!-- Kulit Wajah Cerah (#FFF5F8) -->
          <path 
            d="M245 105 C238 128 240 152 258 165 C275 174 295 174 312 165 C330 152 332 128 325 105 C316 78 254 78 245 105 Z" 
            fill="#FFF5F8" 
            stroke="#4E2A36" 
            stroke-width="4.5" 
          />
          
          <!-- Garis Lengkung Kerudung Membungkus Kening Halus -->
          <path d="M245 105 Q285 82 325 105" stroke="#4E2A36" stroke-width="4.5" fill="none" stroke-linecap="round" />
          <path d="M248 102 Q285 86 322 102" stroke="#EE7A9A" stroke-width="2" fill="none" opacity="0.7" />
        </g>

        <!-- 3. EKSPRESI WAJAH: ALIS, KACAMATA BULAT, MATA & SENYUM -->
        <g class="chef-face-features">
          
          <!-- Alis Ceria Melengkung Coklat Plum -->
          <path d="M256 94 Q268 86 278 94" stroke="#4E2A36" stroke-width="4" stroke-linecap="round" fill="none" />
          <path d="M292 94 Q302 86 314 94" stroke="#4E2A36" stroke-width="4" stroke-linecap="round" fill="none" />

          <!-- KACAMATA BULAT RETRO BESAR & MANIS -->
          <g class="chef-glasses">
            <!-- Frame Kiri Bulat Kawat -->
            <circle cx="267" cy="122" r="17.5" fill="none" stroke="#4E2A36" stroke-width="4.5" />
            <!-- Frame Kanan Bulat Kawat -->
            <circle cx="303" cy="122" r="17.5" fill="none" stroke="#4E2A36" stroke-width="4.5" />
            <!-- Jembatan Kacamata di Antara Hidung -->
            <path d="M284.5 120 Q285 116 285.5 120" stroke="#4E2A36" stroke-width="4.5" fill="none" stroke-linecap="round" />
            <!-- Gagang Kacamata ke Samping Kerudung -->
            <line x1="249.5" y1="120" x2="242" y2="120" stroke="#4E2A36" stroke-width="3.5" stroke-linecap="round" />
            <line x1="320.5" y1="120" x2="328" y2="120" stroke="#4E2A36" stroke-width="3.5" stroke-linecap="round" />
          </g>

          <!-- MATA KARTUN BULAT BESAR & BERSINAR DENGAN KELOPAK BERKEDIP -->
          <g class="chef-eyes">
            <!-- Mata Kiri -->
            <g class="eye-l">
              <ellipse cx="267" cy="122" rx="8" ry="10" fill="#4E2A36" />
              <!-- Kilau Cahaya Putih (Anime/Cartoon Glint) -->
              <circle cx="264" cy="119" r="3" fill="#FFFFFF" />
              <circle cx="269" cy="125" r="1.5" fill="#FFFFFF" />
              <!-- Bulu Mata Lentik Manis -->
              <path d="M255 116 Q253 112 250 114" stroke="#4E2A36" stroke-width="2.5" stroke-linecap="round" fill="none" />
              <!-- Kelopak Mata Berkedip -->
              <path class="chef-eyelid" d="M251 122 Q267 106 283 122 Z" fill="#FFF5F8" stroke="#4E2A36" stroke-width="2.5" />
            </g>

            <!-- Mata Kanan -->
            <g class="eye-r">
              <ellipse cx="303" cy="122" rx="8" ry="10" fill="#4E2A36" />
              <!-- Kilau Cahaya Putih -->
              <circle cx="300" cy="119" r="3" fill="#FFFFFF" />
              <circle cx="305" cy="125" r="1.5" fill="#FFFFFF" />
              <!-- Bulu Mata Lentik Manis -->
              <path d="M315 116 Q317 112 320 114" stroke="#4E2A36" stroke-width="2.5" stroke-linecap="round" fill="none" />
              <!-- Kelopak Mata Berkedip -->
              <path class="chef-eyelid" d="M287 122 Q303 106 319 122 Z" fill="#FFF5F8" stroke="#4E2A36" stroke-width="2.5" />
            </g>
          </g>

          <!-- Pipi Merona Pink Ceria dengan Garis Blush Halus (#EE7A9A) -->
          <g class="cheeks-blush">
            <ellipse cx="249" cy="139" rx="10" ry="7" fill="#EE7A9A" opacity="0.8" />
            <ellipse cx="321" cy="139" rx="10" ry="7" fill="#EE7A9A" opacity="0.8" />
            <!-- Garis Blush Kartun -->
            <line x1="246" y1="137" x2="249" y2="141" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" opacity="0.9" />
            <line x1="250" y1="137" x2="253" y2="141" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" opacity="0.9" />
            <line x1="318" y1="137" x2="321" y2="141" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" opacity="0.9" />
            <line x1="322" y1="137" x2="325" y2="141" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" opacity="0.9" />
          </g>

          <!-- SENYUM LEBAR GEMBIRA ("D" SHAPE SMILE DENGAN LIDAH PINK) -->
          <g class="chef-smile">
            <path d="M272 144 Q285 144 298 144 C298 160 272 160 272 144 Z" fill="#EE7A9A" stroke="#4E2A36" stroke-width="3.5" stroke-linejoin="round" />
            <!-- Lidah Kecil Manis -->
            <path d="M277 150 Q285 146 293 150 C293 158 277 158 277 150 Z" fill="#FCE8EE" />
          </g>

        </g>
      </g>
    </g>
  </svg>
</div>

<style>
  /* ==========================================================================
     ANIMASI GPU MURNI 60FPS DI HP (Tanpa Beban Runtime JS)
     ========================================================================== */

  /* 1. Lambaian Tangan Sarung Oven Melambai Hangat */
  .chef-arm-right {
    transform-origin: 315px 190px;
    animation: chefWave 1.5s ease-in-out infinite alternate;
  }

  @keyframes chefWave {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(14deg);
    }
  }

  /* 2. Goyang Napas Badan Koki */
  .chef-torso {
    transform-origin: center bottom;
    animation: chefBreathe 2.4s ease-in-out infinite alternate;
  }

  @keyframes chefBreathe {
    0% {
      transform: scaleY(1) scaleX(1);
    }
    100% {
      transform: scaleY(1.02) scaleX(0.99);
    }
  }

  /* 3. Goyang Kepala & Kerudung Halus */
  .chef-head {
    transform-origin: 285px 170px;
    animation: chefHeadBob 3s ease-in-out infinite alternate;
  }

  @keyframes chefHeadBob {
    0% {
      transform: rotate(-1.5deg) translateY(0);
    }
    100% {
      transform: rotate(1.5deg) translateY(-2px);
    }
  }

  /* 4. Kelopak Mata Berkedip Spontan */
  .chef-eyelid {
    transform-origin: center center;
    animation: chefBlink 4.4s infinite;
  }

  @keyframes chefBlink {
    0%, 94%, 100% {
      transform: scaleY(0);
      opacity: 0;
    }
    96%, 98% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  /* 5. Uap Panas Melayang dari Oven */
  .steam-line-1 {
    animation: steamFloat 2.6s ease-out infinite;
  }
  .steam-line-2 {
    animation: steamFloat 2.8s ease-out 0.8s infinite;
  }
  .steam-line-3 {
    animation: steamFloat 2.4s ease-out 1.5s infinite;
  }

  @keyframes steamFloat {
    0% {
      transform: translateY(0px) scale(0.9);
      opacity: 0;
    }
    30% {
      opacity: 0.8;
    }
    100% {
      transform: translateY(-26px) scale(1.15);
      opacity: 0;
    }
  }

  /* 6. Pendar Hangat Oven Berkedip Halus */
  .oven-glow-ambient {
    animation: ovenPulse 2.8s ease-in-out infinite alternate;
  }

  @keyframes ovenPulse {
    0% {
      opacity: 0.15;
    }
    100% {
      opacity: 0.32;
    }
  }

  /* 7. Balon Sapaan Mengambang Lembut */
  .mascot-bubble {
    animation: bubbleFloat 2.8s ease-in-out infinite alternate;
  }

  @keyframes bubbleFloat {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-4px);
    }
  }

  /* Mode Hemat Gerakan (Accessibility) */
  @media (prefers-reduced-motion: reduce) {
    .chef-arm-right,
    .chef-torso,
    .chef-head,
    .chef-eyelid,
    .steam-line-1,
    .steam-line-2,
    .steam-line-3,
    .oven-glow-ambient,
    .mascot-bubble {
      animation: none !important;
    }
  }
</style>
