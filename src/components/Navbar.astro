---
import { STORE_INFO } from '../data/cakes';
---

<header class="sticky top-0 z-40 bg-[#FAF7F2] border-b border-[#291811]/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
    <a href="/" class="flex flex-col group py-1">
      <span class="text-xl sm:text-2xl font-serif font-bold text-[#291811] tracking-tight group-hover:text-[#9E5316] transition-colors">
        {STORE_INFO.name}
      </span>
      <span class="text-xs text-[#291811]/80 font-medium">
        Kue Ulang Tahun Brownies &bull; Gambut
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[#291811]/90">
      <a href="#galeri" class="hover:text-[#9E5316] transition-colors py-2">
        Katalog Kue
      </a>
      <a href="#cara-pesan" class="hover:text-[#9E5316] transition-colors py-2">
        Cara Pesan & Pengiriman
      </a>
      <a href="#kontak" class="hover:text-[#9E5316] transition-colors py-2">
        Lokasi
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a 
        href={`https://wa.me/${STORE_INFO.whatsappNumber}?text=Halo%20Kak%20Winda%20(aydin's%20Kitchen),%20saya%20mau%20tanya%20slot%20kue.`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center min-h-[44px] bg-[#1E7E34] hover:bg-[#186429] text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors shadow-xs active:translate-y-px"
      >
        Chat Pemilik Toko
      </a>
    </div>
  </div>
</header>
