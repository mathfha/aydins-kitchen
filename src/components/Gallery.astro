---
import { CAKES, CATEGORIES, STORE_INFO } from '../data/cakes';

const formatRupiah = (num: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(num);
};

const categoryIcons: Record<string, string> = {
  'Semua': '',
  'Brownies Ultah': '/icons/brownies-ultah.svg',
  'Bento Cake': '/icons/bento-cake.svg',
  'Kue Kering': '/icons/kue-kering.svg',
  'Dessert Box': '/icons/dessert-box.svg',
};
---

<section id="galeri" class="py-10 sm:py-16 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="mb-6 sm:mb-8">
    <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#4E2A36] mb-2">
      Koleksi Desain Kue Pilihan
    </h2>
    <p class="text-sm sm:text-base text-[#4E2A36]/80 max-w-xl">
      Pilih desain kue favorit Anda dan pesan langsung ke WhatsApp Kak Winda.
    </p>
  </div>

  <!-- Filter Kategori (Langsung di atas latar pink, tanpa warna coklat & tanpa angka) -->
  <div class="flex items-center gap-2.5 sm:gap-3 overflow-x-auto mb-8 pb-1.5 sm:pb-0 sm:flex-wrap -mx-4 px-4 sm:mx-0 sm:px-0" id="filter-container">
    {CATEGORIES.map((category, index) => {
      const icon = categoryIcons[category];
      return (
        <button
          type="button"
          data-filter={category}
          class={`filter-btn btn-dock-pill ${index === 0 ? 'btn-dock-active' : 'btn-dock-inactive'}`}
        >
          {icon && (
            <img
              src={icon}
              alt=""
              width="22"
              height="22"
              class="w-5.5 h-5.5 mr-1.5 inline-block shrink-0 align-middle pointer-events-none"
              loading="eager"
            />
          )}
          <span>{category}</span>
        </button>
      );
    })}
  </div>

  <!-- Masonry cards -->
  <div class="masonry-grid" id="masonry-gallery">
    {CAKES.map((cake) => {
      const aspectClass = cake.aspectRatio === 'tall' 
        ? 'aspect-[3/4]' 
        : cake.aspectRatio === 'portrait' 
          ? 'aspect-[4/5]' 
          : 'aspect-square';

      const waMessage = `Halo Kak Winda (aydin's Kitchen),\n\nSaya ingin memesan kue:\n* Desain: ${cake.name}\n* Kategori: ${cake.category}\n* Estimasi Harga: ${formatRupiah(cake.price)}\n* Ukuran/Porsi: ${cake.dimensions}\n\nApakah slot tanggal acara saya masih tersedia? Terima kasih.`;
      const waLink = `https://wa.me/${STORE_INFO.whatsappNumber}?text=${encodeURIComponent(waMessage)}`;

      return (
        <article
          class="masonry-item cake-card group bg-white rounded-2xl p-2.5 sm:p-3 border border-[#F7D5DE] hover:border-[#EE7A9A] transition-all duration-200 shadow-2xs hover:shadow-md flex flex-col justify-between"
          data-category={cake.category}
          data-id={cake.id}
        >
          <!-- Bingkai Foto Polaroid Inset -->
          <div class={`relative w-full ${aspectClass} overflow-hidden rounded-xl bg-[#FCEAEF]`}>
            <img
              src={cake.imageUrl}
              alt={cake.name}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-300"
            />
            
            <div class="absolute top-2.5 left-2.5">
              <span class="bg-[#EE7A9A] text-white text-[10px] sm:text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-xs">
                {cake.category}
              </span>
            </div>
          </div>

          <!-- Keterangan & Aksi -->
          <div class="pt-3 px-1 pb-1">
            <h3 class="font-serif font-bold text-sm sm:text-base text-[#4E2A36] leading-snug line-clamp-1 mb-1.5">
              {cake.name}
            </h3>

            <!-- Badge Porsi Pastel Pink -->
            <div class="mb-3">
              <span class="inline-flex items-center gap-1 text-[11px] font-medium text-[#4E2A36]/80 bg-[#FCE8EE] px-2.5 py-0.5 rounded-md">
                <span>🍰</span>
                <span>{cake.dimensions}</span>
              </span>
            </div>

            <!-- Baris Harga & Tombol Pesan Rose Pink Harmonis -->
            <div class="flex items-center justify-between text-xs gap-2 pt-2 border-t border-[#F7D5DE]/70">
              <div>
                <span class="text-[10px] text-[#4E2A36]/60 block leading-tight">Mulai dari</span>
                <span class="font-bold text-[#EE7A9A] price-tabular text-sm sm:text-base">
                  {formatRupiah(cake.price)}
                </span>
              </div>
              <a 
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-[11px] font-bold text-white bg-[#EE7A9A] hover:bg-[#E86B8C] px-3 py-1.5 rounded-full shadow-2xs hover:shadow-xs transition-all active:scale-95 shrink-0"
                aria-label={`Pesan ${cake.name} ke WhatsApp Kak Winda`}
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.697c1.002.546 1.761.822 2.806.823h.005c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.77-5.773-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
                </svg>
                <span>Pesan WA</span>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script is:inline>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cakeCards = document.querySelectorAll('.cake-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter');

      filterBtns.forEach(b => {
        b.classList.remove('btn-dock-active');
        b.classList.add('btn-dock-inactive');
      });
      btn.classList.add('btn-dock-active');
      btn.classList.remove('btn-dock-inactive');

      cakeCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const isMatch = selected === 'Semua' || cat === selected;
        card.style.display = isMatch ? 'block' : 'none';
        if (isMatch) card.classList.add('fade-in');
      });
    });
  });
</script>
